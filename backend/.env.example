# バックエンド（FastAPI）環境変数の例。実値は .env にコピーするか、環境で設定する。
# .env は git 管理外にすること。

# データベース（未設定ならローカル開発用に SQLite へフォールバック）。
# 例: postgresql+psycopg://user:pass@localhost:5432/crossborder
# DATABASE_URL=

# 認証（本番では必ずランダムな秘密鍵を設定）。
# AUTH_SECRET=change-me
# AUTH_TOKEN_TTL_HOURS=72

# 自動監視スケジューラ（>0 で有効、既定 0 = 無効。本番は Worker/cron 推奨）。
# MONITOR_INTERVAL_SECONDS=3600
# ALERT_SCORE=60
# SEASON_ALERT_DAYS=60

# LLM（未設定ならルールベースで動作）。
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ---- 実データ源（datasources / HttpDataSource）----
# DATA_SOURCE_URL 未設定なら http データ源は無効（0 件を返す安全な no-op）。
# 正規 API / 許可されたデータ提供エンドポイントのみを指定すること（原則: セクション 9）。
# DATA_SOURCE_URL=https://api.example.com/products
# DATA_SOURCE_API_KEY=
# DATA_SOURCE_NAME=example
